# ─── Secrets ──────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# Behaviour (thresholds, ranges, exit rules) lives in user-config.json instead.

# Base58 private key (Phantom/Solflare export) or a JSON byte array.
# Use a dedicated wallet funded only with what you intend to risk.
WALLET_PRIVATE_KEY=

# A private RPC is strongly recommended. The public endpoint rate limits hard and
# the watcher polls every open position every 20 seconds.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional second endpoint used only by the fast watcher, so its polling never
# competes with the agent's own reads.
WATCHER_RPC_URL=

# ─── Model ────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint with tool calling works. Set
# the API root (usually ending in /v1) and the model ids that endpoint expects.
# These can also live in user-config.json as llmBaseUrl / screenModel / etc.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-4.5

# OPENROUTER_API_KEY is accepted as an alias for LLM_API_KEY.
OPENROUTER_API_KEY=

# Other endpoints — same shape, different host and model ids:
#   OpenAI            LLM_BASE_URL=https://api.openai.com/v1
#   any gateway       LLM_BASE_URL=https://your-gateway.example.com/v1
#   LM Studio         LLM_BASE_URL=http://localhost:1234/v1     LLM_API_KEY=local
#   Ollama            LLM_BASE_URL=http://localhost:11434/v1    LLM_API_KEY=ollama
#   vLLM / llama.cpp  LLM_BASE_URL=http://localhost:8000/v1     LLM_API_KEY=local
#
# Verify any endpoint before a long run: scripts/preflight.sh makes one real
# tool-calling round trip and fails loudly if the endpoint or model cannot do it.

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# Create a bot with @BotFather. The chat id must be set explicitly — the bot
# never adopts whoever messages it first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required to accept commands from a group, ignored for direct messages.
TELEGRAM_ALLOWED_USER_IDS=

# ─── Hivemind (optional) ──────────────────────────────────────────────────────
# Off unless a URL is set. Run your own with `npm run hivemind:serve`.
HIVEMIND_URL=
HIVEMIND_API_KEY=

# ─── Creator fee ──────────────────────────────────────────────────────────────
# ON by default: 0.5% of every Jupiter swap goes to the project's referral
# account (Jupiter keeps 20% of that). Swaps happen when a position opens and
# closes. Paper mode is never charged. See "Creator fee" in the README.
#
# AETERNUM_REFERRAL_FEE_BPS=0                # turn it off
# AETERNUM_REFERRAL_ACCOUNT=                 # or send it to your own referral account
# AETERNUM_REFERRAL_FEE_BPS=50               # 50-255; anything else is ignored

# ─── Optional ─────────────────────────────────────────────────────────────────
# Paid Jupiter endpoint. Without it the free rate-limited host is used.
JUPITER_API_KEY=
# Mirror all logs to a file (pm2 already captures stdout).
LOG_FILE=

# ─── Mode ─────────────────────────────────────────────────────────────────────
# true  = simulate everything, sign nothing
# false = real transactions with real money
DRY_RUN=true
